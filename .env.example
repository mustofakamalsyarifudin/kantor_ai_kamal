# Copy this file to .env and change every CHANGE_ME value before use.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://kantorai:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/kantorai?schema=public
REDIS_URL=redis://127.0.0.1:6379
# M2 task engine: dry-run memproses antrean dan membuat artefak diagnostik tanpa memanggil AI.
TASK_EXECUTOR_MODE=dry-run
TASK_WORKER_CONCURRENCY=2
ARTIFACTS_DIR=./data/artifacts
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_NAME=Workspace Owner
BOOTSTRAP_ADMIN_EMAIL=admin@kantorai.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD
VITE_API_URL=http://127.0.0.1:4000
