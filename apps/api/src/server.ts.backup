import "dotenv/config";
import path from "node:path";
import fs from "node:fs/promises";
import dotenv from "dotenv";
import Fastify, { type FastifyReply, type FastifyRequest } from "fastify";
import cors from "@fastify/cors";
import jwt from "@fastify/jwt";
import bcrypt from "bcryptjs";
import OpenAI from "openai";
import { Prisma, PrismaClient, AgentState, TaskPriority, TaskStatus } from "@prisma/client";
import { Server as SocketServer } from "socket.io";
import { z, ZodError } from "zod";
import { createRedisConnection, createTaskQueue, priorityForQueue, TASK_QUEUE_NAME, WORKER_EVENT_CHANNEL, WORKER_HEARTBEAT_KEY, type TaskJobPayload } from "./task-queue.js";

dotenv.config({ path: path.resolve(process.cwd(), "../../.env") });

const prisma = new PrismaClient();
const apiHost = process.env.API_HOST || "127.0.0.1";
const apiPort = Number(process.env.API_PORT || 4000);
const frontendOrigin = process.env.FRONTEND_ORIGIN || "http://localhost:5173";
const jwtSecret = process.env.JWT_SECRET;
if (!jwtSecret || jwtSecret.startsWith("CHANGE_ME") || jwtSecret.length < 32) {
  throw new Error("JWT_SECRET belum diatur. Salin .env.example menjadi .env dan isi JWT_SECRET acak minimal 32 karakter.");
}

const app = Fastify({ logger: true, bodyLimit: 1_000_000 });
await app.register(cors, { origin: frontendOrigin, credentials: true });
await app.register(jwt, { secret: jwtSecret, sign: { expiresIn: "4h" } });

const io = new SocketServer(app.server, {
  cors: { origin: frontendOrigin, methods: ["GET", "POST"], credentials: true },
  transports: ["websocket", "polling"]
});

const taskQueue = createTaskQueue();
const workerEventSubscriber = createRedisConnection();
const redisHealthClient = createRedisConnection();
const projectRoot = path.resolve(process.cwd(), path.basename(process.cwd()) === "api" ? "../.." : ".");
const artifactRoot = path.resolve(projectRoot, process.env.ARTIFACTS_DIR || "data/artifacts");
const executorMode = (process.env.TASK_EXECUTOR_MODE || "dry-run").trim().toLowerCase();
const openAiApiKey = process.env.OPENAI_API_KEY?.trim() || "";
const openAiModel = process.env.OPENAI_MODEL?.trim() || "gpt-5.5";
const openAiConfigured = Boolean(openAiApiKey && !openAiApiKey.startsWith("CHANGE_ME"));

function safeProviderError(error: unknown): string {
  const raw = error instanceof Error ? error.message : "Kesalahan provider OpenAI yang tidak diketahui.";
  return raw.replace(/sk-[A-Za-z0-9_-]{8,}/g, "[REDACTED_API_KEY]")
    .replace(/Bearer\s+[^\s]+/gi, "Bearer [REDACTED]")
    .slice(0, 500);
}

io.use((socket, next) => {
  const token = socket.handshake.auth?.token;
  if (typeof token !== "string" || !token) return next(new Error("UNAUTHORIZED"));
  try {
    const payload = app.jwt.verify(token) as { sub: string; workspaceId: string };
    if (!payload.workspaceId || !payload.sub) return next(new Error("UNAUTHORIZED"));
    socket.data.userId = payload.sub;
    socket.data.workspaceId = payload.workspaceId;
    next();
  } catch {
    next(new Error("UNAUTHORIZED"));
  }
});

io.on("connection", socket => {
  socket.join(`workspace:${String(socket.data.workspaceId)}`);
  socket.emit("workspace:connected", { workspaceId: socket.data.workspaceId });
});

void workerEventSubscriber.subscribe(WORKER_EVENT_CHANNEL).catch(error => {
  app.log.error({ err: error }, "Tidak dapat subscribe event task worker dari Redis");
});
workerEventSubscriber.on("message", (channel, rawMessage) => {
  if (channel !== WORKER_EVENT_CHANNEL) return;
  try {
    const event = JSON.parse(rawMessage) as { workspaceId?: string; type?: string; data?: unknown; at?: string };
    if (!event.workspaceId || !event.type) return;
    emitWorkspace(event.workspaceId, event.type, event.data);
  } catch (error) {
    app.log.warn({ err: error }, "Pesan event worker tidak valid");
  }
});

function emitWorkspace(workspaceId: string, type: string, data: unknown) {
  io.to(`workspace:${workspaceId}`).emit("workspace:event", {
    type,
    data,
    at: new Date().toISOString()
  });
}

async function authenticate(request: FastifyRequest, reply: FastifyReply) {
  try {
    await request.jwtVerify();
  } catch {
    return reply.code(401).send({ error: "UNAUTHORIZED", message: "Sesi tidak valid atau sudah berakhir. Silakan login kembali." });
  }
}

function workspaceIdOf(request: FastifyRequest): string {
  return request.user.workspaceId;
}

function safeAgent(agent: any) {
  if (!agent) return agent;
  const { systemPrompt, ...safe } = agent;
  return { ...safe, hasSystemPrompt: Boolean(systemPrompt) };
}

function slugify(value: string) {
  return value.normalize("NFKD").toLowerCase().replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 55) || "agent";
}

async function uniqueAgentSlug(workspaceId: string, name: string) {
  const base = slugify(name);
  let candidate = base;
  let suffix = 2;
  while (await prisma.agent.findUnique({ where: { workspaceId_slug: { workspaceId, slug: candidate } }, select: { id: true } })) {
    candidate = `${base}-${suffix++}`;
  }
  return candidate;
}

const loginSchema = z.object({ email: z.string().email().max(254), password: z.string().min(1).max(200) });
const agentCreateSchema = z.object({
  name: z.string().trim().min(2).max(60),
  role: z.string().trim().min(2).max(100),
  departmentCode: z.string().trim().min(2).max(40),
  description: z.string().trim().max(2000).optional().default(""),
  systemPrompt: z.string().max(12000).optional().default(""),
  provider: z.string().trim().max(50).optional().nullable(),
  model: z.string().trim().max(100).optional().nullable(),
  allowedTools: z.array(z.string().trim().min(1).max(80)).max(50).optional().default([]),
  dailyBudget: z.number().positive().max(10000).optional().nullable(),
  visualConfig: z.record(z.unknown()).optional().nullable()
});
const agentUpdateSchema = agentCreateSchema.partial().extend({ enabled: z.boolean().optional() });
const taskCreateSchema = z.object({
  title: z.string().trim().min(3).max(180),
  instruction: z.string().trim().min(3).max(12000),
  priority: z.nativeEnum(TaskPriority).optional().default(TaskPriority.NORMAL),
  assignedAgentId: z.string().optional().nullable(),
  dueAt: z.string().datetime().optional().nullable(),
  submitNow: z.boolean().optional().default(false)
});
const taskStatusSchema = z.object({ status: z.nativeEnum(TaskStatus) });

const transitions: Record<TaskStatus, TaskStatus[]> = {
  DRAFT: ["QUEUED", "CANCELLED"],
  QUEUED: ["PLANNING", "RUNNING", "PAUSED", "CANCELLED", "BLOCKED"],
  PLANNING: ["RUNNING", "BLOCKED", "FAILED", "CANCELLED"],
  RUNNING: ["REVIEW_REQUIRED", "COMPLETED", "BLOCKED", "FAILED", "PAUSED", "CANCELLED"],
  REVIEW_REQUIRED: ["COMPLETED", "RUNNING", "CANCELLED"],
  COMPLETED: [],
  PAUSED: ["QUEUED", "RUNNING", "CANCELLED"],
  FAILED: ["QUEUED", "CANCELLED"],
  CANCELLED: [],
  BLOCKED: ["QUEUED", "CANCELLED"]
};

function httpError(statusCode: number, message: string) {
  return Object.assign(new Error(message), { statusCode });
}

async function queueTaskRecord(taskId: string, workspaceId: string, actorId: string, allowedFrom: TaskStatus[]) {
  const task = await prisma.task.findFirst({
    where: { id: taskId, workspaceId },
    include: { assignedAgent: true }
  });
  if (!task) throw httpError(404, "Tugas tidak ditemukan di workspace ini.");
  if (!allowedFrom.includes(task.status)) {
    throw httpError(409, `Tugas berstatus ${task.status} tidak dapat dimasukkan ke antrean dari tindakan ini.`);
  }
  if (!task.assignedAgentId || !task.assignedAgent) {
    throw httpError(400, "Pilih agent penanggung jawab sebelum memasukkan tugas ke antrean.");
  }
  if (!task.assignedAgent.enabled) throw httpError(400, "Agent penanggung jawab tidak aktif. Aktifkan agent atau pilih agent lain.");

  const changed = await prisma.$transaction(async tx => {
    const update = await tx.task.updateMany({
      where: { id: task.id, workspaceId, status: task.status },
      data: { status: TaskStatus.QUEUED }
    });
    if (update.count !== 1) throw httpError(409, "Status tugas berubah saat akan dimasukkan ke antrean. Muat ulang data dan coba lagi.");
    await tx.runEvent.create({
      data: {
        taskId: task.id,
        eventType: "task.queued",
        actorType: "USER",
        message: `Tugas dimasukkan ke antrean dari status ${task.status}.`,
        payload: { from: task.status, to: TaskStatus.QUEUED, priority: task.priority }
      }
    });
    await tx.auditLog.create({
      data: {
        workspaceId,
        actorId,
        action: "task.queued",
        entityType: "task",
        entityId: task.id,
        metadata: { from: task.status, priority: task.priority }
      }
    });
    return tx.task.findUniqueOrThrow({
      where: { id: task.id },
      include: { assignedAgent: { select: { id: true, name: true, role: true, state: true } } }
    });
  });

  try {
    const jobPayload: TaskJobPayload = { taskId: changed.id, workspaceId, actorId, queuedAt: new Date().toISOString() };
    const job = await taskQueue.add("execute-task", jobPayload, {
      jobId: `${changed.id}-${Date.now()}`,
      priority: priorityForQueue(changed.priority),
      attempts: 1,
      removeOnComplete: 500,
      removeOnFail: 1000
    });
    await prisma.runEvent.create({
      data: {
        taskId: changed.id,
        eventType: "queue.job_added",
        actorType: "SYSTEM",
        message: "Job diterima antrean Redis/BullMQ.",
        payload: { jobId: job.id ?? null, queue: TASK_QUEUE_NAME, priority: changed.priority }
      }
    });
    emitWorkspace(workspaceId, "task.queued", { ...changed, jobId: job.id, queue: TASK_QUEUE_NAME });
    return changed;
  } catch (error) {
    const message = error instanceof Error ? error.message : "Koneksi antrean tidak tersedia.";
    const blocked = await prisma.$transaction(async tx => {
      await tx.task.updateMany({ where: { id: changed.id, workspaceId, status: TaskStatus.QUEUED }, data: { status: TaskStatus.BLOCKED } });
      await tx.runEvent.create({
        data: {
          taskId: changed.id,
          eventType: "queue.enqueue_failed",
          actorType: "SYSTEM",
          message: "Tugas tidak dapat dimasukkan ke antrean Redis.",
          payload: { error: message }
        }
      });
      await tx.auditLog.create({ data: { workspaceId, actorId, action: "task.enqueue_failed", entityType: "task", entityId: changed.id, metadata: { error: message } } });
      return tx.task.findUniqueOrThrow({ where: { id: changed.id }, include: { assignedAgent: { select: { id: true, name: true, role: true, state: true } } } });
    });
    emitWorkspace(workspaceId, "task.queue_failed", { taskId: changed.id, message, status: TaskStatus.BLOCKED });
    return { ...blocked, queueWarning: "Redis/BullMQ tidak menerima job. Periksa layanan Redis dan task worker." };
  }
}

async function removeWaitingJobs(taskId: string) {
  const jobs = await taskQueue.getJobs(["waiting", "delayed", "paused"], 0, 1000, true).catch(() => []);
  await Promise.allSettled(jobs.filter(job => job.data.taskId === taskId).map(job => job.remove()));
}

async function changeControlTaskStatus(
  taskId: string,
  workspaceId: string,
  actorId: string,
  nextStatus: TaskStatus,
  allowedFrom: TaskStatus[],
  eventType: string,
  message: string
) {
  const existing = await prisma.task.findFirst({ where: { id: taskId, workspaceId } });
  if (!existing) throw httpError(404, "Tugas tidak ditemukan di workspace ini.");
  if (!allowedFrom.includes(existing.status)) throw httpError(409, `Tugas berstatus ${existing.status} tidak dapat ${message.toLowerCase()}.`);
  const updated = await prisma.$transaction(async tx => {
    const update = await tx.task.updateMany({ where: { id: taskId, workspaceId, status: existing.status }, data: { status: nextStatus } });
    if (update.count !== 1) throw httpError(409, "Status tugas berubah saat tindakan diproses. Muat ulang data dan coba lagi.");
    await tx.runEvent.create({
      data: { taskId, eventType, actorType: "USER", message, payload: { from: existing.status, to: nextStatus } }
    });
    await tx.auditLog.create({
      data: { workspaceId, actorId, action: eventType, entityType: "task", entityId: taskId, metadata: { from: existing.status, to: nextStatus } }
    });
    return tx.task.findUniqueOrThrow({
      where: { id: taskId },
      include: { assignedAgent: { select: { id: true, name: true, role: true, state: true } }, _count: { select: { runs: true, artifacts: true } } }
    });
  });
  emitWorkspace(workspaceId, eventType, updated);
  return updated;
}

app.setErrorHandler((error, request, reply) => {
  if (error instanceof ZodError) {
    return reply.code(400).send({ error: "VALIDATION_ERROR", message: "Periksa kembali data yang dikirim.", details: error.issues.map(issue => ({ path: issue.path.join("."), message: issue.message })) });
  }
  if (error instanceof Prisma.PrismaClientKnownRequestError && error.code === "P2002") {
    return reply.code(409).send({ error: "CONFLICT", message: "Data dengan identitas tersebut sudah ada." });
  }
  const statusCode = Number((error as Error & { statusCode?: number }).statusCode || 500);
  if (statusCode >= 400 && statusCode < 500) {
    return reply.code(statusCode).send({ error: "REQUEST_ERROR", message: error.message });
  }
  request.log.error({ err: error }, "Unhandled request error");
  return reply.code(500).send({ error: "INTERNAL_ERROR", message: "Terjadi kesalahan internal. Periksa log API untuk detail." });
});

app.get("/health", async (_request, reply) => {
  try {
    await prisma.$queryRaw`SELECT 1`;
    return { status: "ok", database: "connected", service: "kantorai-api", time: new Date().toISOString() };
  } catch {
    return reply.code(503).send({ status: "degraded", database: "unavailable", service: "kantorai-api" });
  }
});

app.post("/api/auth/login", async (request, reply) => {
  const body = loginSchema.parse(request.body);
  const user = await prisma.user.findUnique({ where: { email: body.email.toLowerCase() }, include: { workspace: true } });
  if (!user || !user.active || !(await bcrypt.compare(body.password, user.passwordHash)) || !user.workspace) {
    return reply.code(401).send({ error: "INVALID_CREDENTIALS", message: "Email atau password tidak sesuai, atau workspace belum dibuat." });
  }
  const token = app.jwt.sign({ sub: user.id, email: user.email, name: user.name, workspaceId: user.workspace.id });
  return { accessToken: token, tokenType: "Bearer", expiresInSeconds: 14400, user: { id: user.id, email: user.email, name: user.name }, workspace: { id: user.workspace.id, name: user.workspace.name, slug: user.workspace.slug } };
});

app.get("/api/me", { preHandler: authenticate }, async request => {
  return { user: { id: request.user.sub, email: request.user.email, name: request.user.name }, workspaceId: request.user.workspaceId };
});

app.get("/api/departments", { preHandler: authenticate }, async request => {
  return prisma.department.findMany({ where: { workspaceId: workspaceIdOf(request) }, orderBy: { sortOrder: "asc" } });
});

app.get("/api/agents", { preHandler: authenticate }, async request => {
  const agents = await prisma.agent.findMany({
    where: { workspaceId: workspaceIdOf(request) },
    include: { department: { select: { id: true, code: true, name: true } } },
    orderBy: [{ enabled: "desc" }, { createdAt: "asc" }]
  });
  return agents.map(safeAgent);
});

app.get<{ Params: { id: string } }>("/api/agents/:id", { preHandler: authenticate }, async (request, reply) => {
  const agent = await prisma.agent.findFirst({ where: { id: request.params.id, workspaceId: workspaceIdOf(request) }, include: { department: true } });
  if (!agent) return reply.code(404).send({ error: "NOT_FOUND", message: "Agent tidak ditemukan." });
  return safeAgent(agent);
});

app.post("/api/agents", { preHandler: authenticate }, async (request, reply) => {
  const body = agentCreateSchema.parse(request.body);
  const workspaceId = workspaceIdOf(request);
  const department = await prisma.department.findFirst({ where: { workspaceId, code: body.departmentCode } });
  if (!department) return reply.code(400).send({ error: "INVALID_DEPARTMENT", message: "Departemen tidak ditemukan di workspace ini." });
  const slug = await uniqueAgentSlug(workspaceId, body.name);
  const agent = await prisma.agent.create({
    data: {
      workspaceId, slug, name: body.name, role: body.role, departmentId: department.id,
      description: body.description, systemPrompt: body.systemPrompt,
      provider: body.provider ?? null, model: body.model ?? null,
      allowedTools: body.allowedTools,
      dailyBudget: body.dailyBudget == null ? null : new Prisma.Decimal(body.dailyBudget),
      visualConfig: body.visualConfig == null ? Prisma.JsonNull : body.visualConfig as Prisma.InputJsonValue
    },
    include: { department: { select: { id: true, code: true, name: true } } }
  });
  emitWorkspace(workspaceId, "agent.created", safeAgent(agent));
  await prisma.auditLog.create({ data: { workspaceId, actorId: request.user.sub, action: "agent.created", entityType: "agent", entityId: agent.id, metadata: { name: agent.name, role: agent.role } } });
  return safeAgent(agent);
});

app.patch<{ Params: { id: string } }>("/api/agents/:id", { preHandler: authenticate }, async (request, reply) => {
  const body = agentUpdateSchema.parse(request.body);
  const workspaceId = workspaceIdOf(request);
  const existing = await prisma.agent.findFirst({ where: { id: request.params.id, workspaceId } });
  if (!existing) return reply.code(404).send({ error: "NOT_FOUND", message: "Agent tidak ditemukan." });
  const data: Prisma.AgentUpdateInput = {};
  if (body.name !== undefined) data.name = body.name;
  if (body.role !== undefined) data.role = body.role;
  if (body.description !== undefined) data.description = body.description;
  if (body.systemPrompt !== undefined) data.systemPrompt = body.systemPrompt;
  if (body.provider !== undefined) data.provider = body.provider;
  if (body.model !== undefined) data.model = body.model;
  if (body.allowedTools !== undefined) data.allowedTools = body.allowedTools;
  if (body.dailyBudget !== undefined) data.dailyBudget = body.dailyBudget == null ? null : new Prisma.Decimal(body.dailyBudget);
  if (body.visualConfig !== undefined) data.visualConfig = body.visualConfig == null ? Prisma.JsonNull : body.visualConfig as Prisma.InputJsonValue;
  if (body.enabled !== undefined) {
    data.enabled = body.enabled;
    if (!body.enabled) data.state = AgentState.DISABLED;
    else if (existing.state === AgentState.DISABLED) data.state = AgentState.IDLE;
  }
  if (body.departmentCode !== undefined) {
    const department = await prisma.department.findFirst({ where: { workspaceId, code: body.departmentCode } });
    if (!department) return reply.code(400).send({ error: "INVALID_DEPARTMENT", message: "Departemen tidak ditemukan di workspace ini." });
    data.department = { connect: { id: department.id } };
  }
  const agent = await prisma.agent.update({ where: { id: existing.id }, data, include: { department: { select: { id: true, code: true, name: true } } } });
  emitWorkspace(workspaceId, "agent.updated", safeAgent(agent));
  await prisma.auditLog.create({ data: { workspaceId, actorId: request.user.sub, action: "agent.updated", entityType: "agent", entityId: agent.id, metadata: { name: agent.name } } });
  return safeAgent(agent);
});

for (const enabled of [false, true]) {
  app.post<{ Params: { id: string } }>(`/api/agents/:id/${enabled ? "enable" : "disable"}`, { preHandler: authenticate }, async (request, reply) => {
    const workspaceId = workspaceIdOf(request);
    const existing = await prisma.agent.findFirst({ where: { id: request.params.id, workspaceId } });
    if (!existing) return reply.code(404).send({ error: "NOT_FOUND", message: "Agent tidak ditemukan." });
    const agent = await prisma.agent.update({ where: { id: existing.id }, data: { enabled, state: enabled ? AgentState.IDLE : AgentState.DISABLED }, include: { department: { select: { id: true, code: true, name: true } } } });
    emitWorkspace(workspaceId, "agent.updated", safeAgent(agent));
    await prisma.auditLog.create({ data: { workspaceId, actorId: request.user.sub, action: enabled ? "agent.enabled" : "agent.disabled", entityType: "agent", entityId: agent.id } });
    return safeAgent(agent);
  });
}

app.get("/api/tasks", { preHandler: authenticate }, async request => {
  return prisma.task.findMany({
    where: { workspaceId: workspaceIdOf(request) },
    include: { assignedAgent: { select: { id: true, name: true, role: true, state: true } }, _count: { select: { runs: true, artifacts: true } } },
    orderBy: { createdAt: "desc" }, take: 200
  });
});

app.post("/api/tasks", { preHandler: authenticate }, async (request, reply) => {
  const body = taskCreateSchema.parse(request.body);
  const workspaceId = workspaceIdOf(request);
  if (body.submitNow && !body.assignedAgentId) {
    return reply.code(400).send({ error: "AGENT_REQUIRED", message: "Pilih agent penanggung jawab sebelum memasukkan tugas ke antrean." });
  }
  if (body.assignedAgentId) {
    const agent = await prisma.agent.findFirst({ where: { id: body.assignedAgentId, workspaceId, enabled: true } });
    if (!agent) throw httpError(400, "Agent tidak ditemukan, tidak aktif, atau di luar workspace.");
  }
  const task = await prisma.task.create({
    data: {
      workspaceId,
      title: body.title,
      instruction: body.instruction,
      priority: body.priority,
      status: TaskStatus.DRAFT,
      assignedAgentId: body.assignedAgentId ?? null,
      dueAt: body.dueAt ? new Date(body.dueAt) : null,
      runEvents: { create: { eventType: "task.created", actorType: "USER", message: "Draft tugas dibuat.", payload: { status: TaskStatus.DRAFT, priority: body.priority } } }
    },
    include: { assignedAgent: { select: { id: true, name: true, role: true, state: true } }, _count: { select: { runs: true, artifacts: true } } }
  });
  emitWorkspace(workspaceId, "task.created", task);
  await prisma.auditLog.create({ data: { workspaceId, actorId: request.user.sub, action: "task.created", entityType: "task", entityId: task.id, metadata: { status: task.status, title: task.title } } });
  if (body.submitNow) return queueTaskRecord(task.id, workspaceId, request.user.sub, [TaskStatus.DRAFT]);
  return task;
});

app.post<{ Params: { id: string } }>("/api/tasks/:id/queue", { preHandler: authenticate }, async request => {
  return queueTaskRecord(request.params.id, workspaceIdOf(request), request.user.sub, [TaskStatus.DRAFT]);
});

app.post<{ Params: { id: string } }>("/api/tasks/:id/retry", { preHandler: authenticate }, async request => {
  const workspaceId = workspaceIdOf(request);
  const existing = await prisma.task.findFirst({ where: { id: request.params.id, workspaceId }, select: { status: true, metadata: true } });
  if (!existing) throw httpError(404, "Tugas tidak ditemukan di workspace ini.");
  const metadata = existing.metadata && typeof existing.metadata === "object" && !Array.isArray(existing.metadata)
    ? existing.metadata as Record<string, unknown>
    : {};
  const retryableStatuses: TaskStatus[] = [TaskStatus.FAILED, TaskStatus.BLOCKED];
  if (existing.status === TaskStatus.REVIEW_REQUIRED && metadata.diagnosticOnly === true) retryableStatuses.push(TaskStatus.REVIEW_REQUIRED);
  return queueTaskRecord(request.params.id, workspaceId, request.user.sub, retryableStatuses);
});

app.post<{ Params: { id: string } }>("/api/tasks/:id/resume", { preHandler: authenticate }, async request => {
  return queueTaskRecord(request.params.id, workspaceIdOf(request), request.user.sub, [TaskStatus.PAUSED]);
});

app.post<{ Params: { id: string } }>("/api/tasks/:id/pause", { preHandler: authenticate }, async request => {
  const workspaceId = workspaceIdOf(request);
  const updated = await changeControlTaskStatus(
    request.params.id, workspaceId, request.user.sub, TaskStatus.PAUSED,
    [TaskStatus.QUEUED, TaskStatus.PLANNING, TaskStatus.RUNNING],
    "task.paused", "Tugas dijeda oleh pengguna."
  );
  await removeWaitingJobs(request.params.id);
  return updated;
});

app.post<{ Params: { id: string } }>("/api/tasks/:id/cancel", { preHandler: authenticate }, async request => {
  const workspaceId = workspaceIdOf(request);
  const updated = await changeControlTaskStatus(
    request.params.id, workspaceId, request.user.sub, TaskStatus.CANCELLED,
    [TaskStatus.DRAFT, TaskStatus.QUEUED, TaskStatus.PLANNING, TaskStatus.RUNNING, TaskStatus.REVIEW_REQUIRED, TaskStatus.PAUSED, TaskStatus.FAILED, TaskStatus.BLOCKED],
    "task.cancelled", "Tugas dibatalkan oleh pengguna."
  );
  await removeWaitingJobs(request.params.id);
  return updated;
});

app.get<{ Params: { id: string } }>("/api/tasks/:id/runs", { preHandler: authenticate }, async (request, reply) => {
  const workspaceId = workspaceIdOf(request);
  const task = await prisma.task.findFirst({ where: { id: request.params.id, workspaceId }, select: { id: true } });
  if (!task) return reply.code(404).send({ error: "NOT_FOUND", message: "Tugas tidak ditemukan di workspace ini." });
  const runs = await prisma.agentRun.findMany({
    where: { taskId: task.id, workspaceId },
    include: {
      agent: { select: { id: true, name: true, role: true } },
      events: { orderBy: { createdAt: "asc" }, take: 100 },
      artifacts: { orderBy: { createdAt: "desc" }, select: { id: true, name: true, mimeType: true, sizeBytes: true, metadata: true, createdAt: true } }
    },
    orderBy: { startedAt: "desc" },
    take: 30
  });
  return runs.map(run => ({ ...run, artifacts: run.artifacts.map(artifact => ({ ...artifact, sizeBytes: artifact.sizeBytes === null ? null : artifact.sizeBytes.toString() })) }));
});

app.get<{ Params: { id: string } }>("/api/tasks/:id/events", { preHandler: authenticate }, async (request, reply) => {
  const workspaceId = workspaceIdOf(request);
  const task = await prisma.task.findFirst({ where: { id: request.params.id, workspaceId }, select: { id: true } });
  if (!task) return reply.code(404).send({ error: "NOT_FOUND", message: "Tugas tidak ditemukan di workspace ini." });
  return prisma.runEvent.findMany({ where: { taskId: task.id }, include: { run: { select: { id: true, status: true } } }, orderBy: { createdAt: "desc" }, take: 200 });
});

app.get("/api/events", { preHandler: authenticate }, async request => {
  const workspaceId = workspaceIdOf(request);
  const events = await prisma.runEvent.findMany({
    where: { task: { is: { workspaceId } } },
    include: {
      task: { select: { id: true, title: true, status: true, assignedAgent: { select: { id: true, name: true } } } },
      run: { select: { id: true, status: true, provider: true, model: true } }
    },
    orderBy: { createdAt: "desc" },
    take: 100
  });
  return events;
});

app.get<{ Params: { id: string } }>("/api/artifacts/:id/download", { preHandler: authenticate }, async (request, reply) => {
  const workspaceId = workspaceIdOf(request);
  const artifact = await prisma.artifact.findFirst({ where: { id: request.params.id, workspaceId } });
  if (!artifact) return reply.code(404).send({ error: "NOT_FOUND", message: "Artefak tidak ditemukan di workspace ini." });
  const filePath = path.resolve(artifactRoot, artifact.storageKey);
  const allowedPrefix = artifactRoot.endsWith(path.sep) ? artifactRoot : `${artifactRoot}${path.sep}`;
  if (!filePath.startsWith(allowedPrefix)) return reply.code(400).send({ error: "INVALID_ARTIFACT_PATH", message: "Lokasi artefak tidak valid." });
  try {
    const content = await fs.readFile(filePath);
    const safeName = artifact.name.replace(/[\r\n\"\/\\]/g, "_");
    return reply.type(artifact.mimeType || "application/octet-stream").header("Content-Disposition", `attachment; filename="${safeName}"`).send(content);
  } catch (error) {
    request.log.error({ err: error, artifactId: artifact.id }, "File artefak tidak dapat dibaca");
    return reply.code(404).send({ error: "ARTIFACT_FILE_NOT_FOUND", message: "File artefak tidak tersedia di penyimpanan lokal." });
  }
});

app.get("/api/provider/status", { preHandler: authenticate }, async () => {
  return {
    provider: "openai",
    configured: openAiConfigured,
    model: openAiModel,
    executorMode,
    canExecuteTasks: openAiConfigured && executorMode === "openai",
    apiKeyExposed: false
  };
});

app.post("/api/provider/test", { preHandler: authenticate }, async (request, reply) => {
  if (!openAiConfigured) {
    return reply.code(400).send({
      error: "OPENAI_NOT_CONFIGURED",
      message: "OPENAI_API_KEY belum diatur di .env. Tambahkan API key secara lokal, lalu restart API. Jangan kirim API key lewat chat atau browser."
    });
  }
  try {
    const client = new OpenAI({ apiKey: openAiApiKey, timeout: 25_000, maxRetries: 0 });
    const response = await client.responses.create({
      model: openAiModel,
      input: "Balas tepat dengan teks: KantorAI OpenAI connection OK.",
      max_output_tokens: 32,
      store: false
    });
    const output = response.output_text?.trim();
    if (!output) throw new Error("OpenAI tidak menghasilkan teks pada tes koneksi.");
    await prisma.auditLog.create({
      data: {
        workspaceId: workspaceIdOf(request),
        actorId: request.user.sub,
        action: "provider.openai_test_succeeded",
        entityType: "provider",
        entityId: "openai",
        metadata: { model: response.model || openAiModel, responseId: response.id } as Prisma.InputJsonValue
      }
    });
    return { ok: true, provider: "openai", model: response.model || openAiModel, responseId: response.id, message: output };
  } catch (error) {
    const message = safeProviderError(error);
    request.log.warn({ provider: "openai", message }, "Tes koneksi OpenAI gagal");
    return reply.code(502).send({ error: "OPENAI_CONNECTION_FAILED", message });
  }
});

app.get("/api/queue/status", { preHandler: authenticate }, async (_request, reply) => {
  try {
    const [counts, heartbeatRaw, redisStatus] = await Promise.all([
      taskQueue.getJobCounts("waiting", "active", "completed", "failed", "delayed", "paused"),
      redisHealthClient.get(WORKER_HEARTBEAT_KEY),
      redisHealthClient.ping()
    ]);
    let worker: Record<string, unknown> | null = null;
    if (heartbeatRaw) {
      try { worker = JSON.parse(heartbeatRaw) as Record<string, unknown>; } catch { worker = null; }
    }
    const lastSeenAt = typeof worker?.lastSeenAt === "string" ? Date.parse(worker.lastSeenAt) : 0;
    const workerOnline = Boolean(worker?.online && lastSeenAt > 0 && Date.now() - lastSeenAt < 12000);
    return {
      status: redisStatus === "PONG" ? "ok" : "degraded",
      queue: TASK_QUEUE_NAME,
      redis: redisStatus === "PONG" ? "connected" : "unavailable",
      workerOnline,
      worker: workerOnline ? worker : null,
      executorMode,
      aiProviderConfigured: openAiConfigured,
      openAiModel,
      providerCanExecute: openAiConfigured && executorMode === "openai",
      aiProviderInvokedByM2Worker: false,
      counts
    };
  } catch (error) {
    request.log.warn({ err: error }, "Status antrean tidak dapat diambil");
    return reply.code(503).send({ status: "degraded", queue: TASK_QUEUE_NAME, redis: "unavailable", workerOnline: false, executorMode, aiProviderConfigured: openAiConfigured, openAiModel, providerCanExecute: openAiConfigured && executorMode === "openai", counts: {} });
  }
});

app.patch<{ Params: { id: string } }>("/api/tasks/:id/status", { preHandler: authenticate }, async (request, reply) => {
  const { status } = taskStatusSchema.parse(request.body);
  const workspaceId = workspaceIdOf(request);
  const task = await prisma.task.findFirst({ where: { id: request.params.id, workspaceId } });
  if (!task) return reply.code(404).send({ error: "NOT_FOUND", message: "Tugas tidak ditemukan." });
  if (status !== TaskStatus.COMPLETED) {
    return reply.code(409).send({ error: "USE_TASK_ACTION", message: "Status antrean, eksekusi, jeda, pembatalan, dan kegagalan dikelola oleh Task Execution Engine. Gunakan aksi task yang tersedia." });
  }
  const metadata = task.metadata && typeof task.metadata === "object" && !Array.isArray(task.metadata)
    ? task.metadata as Record<string, unknown>
    : {};
  if (status === TaskStatus.COMPLETED && metadata.diagnosticOnly === true) {
    return reply.code(409).send({ error: "DIAGNOSTIC_ONLY", message: "Run terakhir hanya laporan diagnostik M2. Ini bukan hasil kerja AI dan belum boleh ditandai selesai sebelum provider AI diintegrasikan pada M3." });
  }
  if (!transitions[task.status].includes(status)) {
    return reply.code(409).send({ error: "INVALID_TRANSITION", message: `Transisi dari ${task.status} ke ${status} tidak diizinkan.`, allowed: transitions[task.status] });
  }
  const updated = await prisma.$transaction(async tx => {
    const changed = await tx.task.update({ where: { id: task.id }, data: { status }, include: { assignedAgent: { select: { id: true, name: true, role: true, state: true } } } });
    await tx.runEvent.create({ data: { taskId: task.id, eventType: "task.status_changed", actorType: "USER", message: `${task.status} → ${status}`, payload: { from: task.status, to: status } } });
    await tx.auditLog.create({ data: { workspaceId, actorId: request.user.sub, action: "task.status_changed", entityType: "task", entityId: task.id, metadata: { from: task.status, to: status } } });
    return changed;
  });
  emitWorkspace(workspaceId, "task.status_changed", updated);
  return updated;
});

const closeGracefully = async () => {
  app.log.info("Menutup KantorAI API...");
  io.close();
  await app.close();
  await Promise.allSettled([
    taskQueue.close(),
    workerEventSubscriber.quit(),
    redisHealthClient.quit(),
    prisma.$disconnect()
  ]);
};
process.once("SIGINT", () => { void closeGracefully().finally(() => process.exit(0)); });
process.once("SIGTERM", () => { void closeGracefully().finally(() => process.exit(0)); });

try {
  await app.listen({ host: apiHost, port: apiPort });
  app.log.info(`KantorAI API berjalan di http://${apiHost}:${apiPort}`);
} catch (error) {
  app.log.error(error);
  await prisma.$disconnect();
  process.exit(1);
}
